  "sql": "PRAGMA user_version = 7;\nCREATE TABLE item (id TEXT PRIMARY KEY, label TEXT, data BLOB);\nCREATE TABLE pending (item_id TEXT, operation TEXT);\nCREATE TRIGGER item_update AFTER UPDATE ON item BEGIN INSERT INTO pending VALUES (new.id, 'update'); END;\nINSERT INTO item VALUES ('existing', 'saved before upgrade', x'0001feff');\nINSERT INTO pending VALUES ('existing', 'insert');",
